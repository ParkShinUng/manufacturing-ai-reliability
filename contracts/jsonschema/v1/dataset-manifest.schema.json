{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mair.local/contracts/v1/dataset-manifest.schema.json",
  "title": "DatasetManifestV1",
  "description": "What a generated training dataset is (OD-025): the configuration that produces it, the labels that come with it, and a hash of the records it produced. Re-running the generator on the same manifest must reproduce the same bytes (NFR-005). Labels here are manifest labels - never events from factory.faults.v1, which has no contract before Phase 11 (OD-020).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "datasetId",
    "generator",
    "telemetrySchemaVersion",
    "featureSchemaVersion",
    "startUtc",
    "durationSeconds",
    "telemetryCadenceMs",
    "equipment",
    "records"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$",
      "description": "Human-readable name. The dataset's identity for lineage is records.sha256, not this."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "tool"],
      "properties": {
        "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tool": { "type": "string", "minLength": 1 }
      }
    },
    "telemetrySchemaVersion": { "const": 1 },
    "featureSchemaVersion": { "type": "integer", "minimum": 1 },
    "startUtc": {
      "type": "string",
      "format": "date-time",
      "description": "Simulated time of the first sample. Generated time, not wall-clock time."
    },
    "durationSeconds": { "type": "integer", "minimum": 60 },
    "telemetryCadenceMs": { "const": 100 },
    "equipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["equipmentId", "seed", "faultProfile", "faultStartSeconds", "tFailSeconds"],
        "properties": {
          "equipmentId": { "type": "string", "pattern": "^eq-[0-9]{3,6}$" },
          "seed": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
          "faultProfile": {
            "enum": [
              "NORMAL",
              "BEARING_DEGRADATION",
              "OVERLOAD",
              "COOLING_DEGRADATION",
              "SENSOR_DRIFT",
              "SENSOR_NOISE",
              "SENSOR_FREEZE",
              "SENSOR_DROPOUT",
              "COMM_LOSS",
              "OOD_PROFILE",
              "DRIVE_STUCK"
            ]
          },
          "faultStartSeconds": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Seconds after startUtc at which the fault profile begins. Null for NORMAL."
          },
          "tFailSeconds": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0,
            "description": "T_fail after the fault starts, for BEARING_DEGRADATION: the RUL label source (EQUIPMENT_MODEL_AND_STATE.md 2.1). Null for every other profile."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "faultProfile": { "const": "BEARING_DEGRADATION" } } },
            "then": { "properties": { "tFailSeconds": { "type": "number" }, "faultStartSeconds": { "type": "integer" } } }
          },
          {
            "if": { "properties": { "faultProfile": { "const": "NORMAL" } } },
            "then": { "properties": { "faultStartSeconds": { "const": null }, "tFailSeconds": { "const": null } } }
          }
        ]
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "count", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "description": "The records file, JSON Lines, one canonical telemetry record per line, relative to the manifest." },
        "count": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Of the records file's bytes. What an MLflow training run records as the dataset's identity (AC-008)."
        }
      }
    }
  }
}
