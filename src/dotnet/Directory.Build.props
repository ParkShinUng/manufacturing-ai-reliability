<Project>

  <!-- CODING_STANDARDS.md "C#/.NET": nullable on, warnings-as-errors for project code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- TOOLCHAIN.md requires exact transitive versions pinned in a lockfile, not just the direct
         packages. Without this a restore on another machine can silently resolve a different
         transitive graph, which is the same class of problem as a floating tag on a container. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- InvariantGlobalization was set here in Phase 1 as a belt-and-braces guard for NFR-010.
         Removed 2026-09-18: the OPC UA stack's ResourceManager loads en-US resources and cannot
         start under it. Determinism never depended on the switch - RawSample.ToCanonicalString
         formats with an explicit InvariantCulture - and that is now asserted directly by
         DeterminismTests.TelemetryIsBitIdenticalUnderAHostileCulture, which is a stronger
         guarantee than a build flag that only happened to hide the ambient culture. -->
  </PropertyGroup>

</Project>
