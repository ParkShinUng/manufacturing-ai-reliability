<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-0024. Plain ADO.NET: OD-014 and OD-015 need every statement written out. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- ADR-0024: the platform's validator, configured with static ES256 keys - no discovery. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventBackbone\Mair.EventBackbone.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Forward-only migrations, one directory per owned schema (OD-016, ADR-0024). -->
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mair.OperationsService.Tests" />
  </ItemGroup>

</Project>
