<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- ADR-0021: a fresh broker per test class, on the image pinned there. The Kafka *module*
         (Testcontainers.Kafka) cannot start the Apache image - see KafkaBroker - so this is the
         core package and an explicit container definition. -->
    <PackageReference Include="Testcontainers" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventBackbone\Mair.EventBackbone.csproj" />
    <!-- The end-to-end check: what the gateway produces, consumed through the production path. -->
    <ProjectReference Include="..\EdgeGateway\Mair.EdgeGateway.csproj" />
    <ProjectReference Include="..\EquipmentSimulator\Mair.EquipmentSimulator.csproj" />
  </ItemGroup>

</Project>
